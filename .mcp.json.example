{
  "mcpServers": {
    "memory": {
      "command": "uv",
      "args": ["run", "--package", "memory-mcp", "memory-mcp"],
      "env": {
        "MEMORY_EMBEDDING_MODEL": "intfloat/multilingual-e5-small"
      }
    },
    "desire-system": {
      "command": "uv",
      "args": ["run", "--package", "desire-system", "desire-system"]
    },
    "sociality": {
      "command": "uv",
      "args": ["run", "--package", "sociality-mcp", "sociality-mcp"]
    },
    "individual-kernel": {
      "command": "uv",
      "args": [
        "run",
        "--package",
        "individual-kernel-mcp",
        "individual-kernel-mcp"
      ]
    }
  }
}
